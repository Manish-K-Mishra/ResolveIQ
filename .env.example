# CloudServe local configuration. Copy to .env and set ONE provider.
# Never commit real secrets or paste them into AI-agent prompts.
CLOUDSERVE_PROVIDER=anthropic
CLOUDSERVE_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=

# Optional local inference (set provider=ollama or provider=llamacpp)
OLLAMA_BASE_URL=http://localhost:11434
LLAMACPP_BASE_URL=http://localhost:8080/v1

# Optional OpenAI
OPENAI_API_KEY=
